# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta publicada no host (mude se 5432 já estiver em uso, ex.: 5433)
POSTGRES_HOST_PORT=5432
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=troque-aqui

# API (back-end)
API_PORT=3000
JWT_SECRET=troque-aqui
JWT_EXPIRES_IN=7d
DIAS_ATRASO=7

# Front-end (Vite)
VITE_API_URL=http://localhost:3000
